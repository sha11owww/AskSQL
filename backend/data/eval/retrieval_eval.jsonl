{"id": "Q001", "query": "上个月华东大区的销售额是多少", "category": "single_metric", "difficulty": "easy", "source": "manual", "required_slots": [{"name": "金额", "any_of": ["ecommerce_ops.orders.paid_amount", "orders_current.paid_amount"]}, {"name": "地区", "any_of": ["ecommerce_ops.orders.region", "orders_current.region"]}, {"name": "时间", "any_of": ["ecommerce_ops.orders.ordered_at", "orders_current.order_date"]}], "forbidden": ["ecommerce_ops.orders.payable_amount", "ecommerce_ops.orders.item_amount", "orders_current.order_amount"], "gold_sql": "SELECT SUM(paid_amount) FROM orders WHERE region='华东' AND ordered_at >= DATE '2026-09-01'", "notes": "销售额=实付金额；payable_amount 应付、item_amount 原始金额是同表强干扰项"}
{"id": "Q002", "query": "一共有多少注册用户", "category": "single_metric", "difficulty": "easy", "source": "manual", "required_slots": [{"name": "用户标识", "any_of": ["ecommerce_ops.users.user_id"]}], "forbidden": [], "gold_sql": "SELECT COUNT(*) FROM users", "notes": "只需用户主表计数"}
{"id": "Q003", "query": "退款总金额是多少", "category": "single_metric", "difficulty": "easy", "source": "manual", "required_slots": [{"name": "退款金额", "any_of": ["ecommerce_ops.refunds.refund_amount"]}], "forbidden": ["ecommerce_ops.orders.paid_amount"], "gold_sql": "SELECT SUM(refund_amount) FROM refunds", "notes": "退款用 refunds.refund_amount，不是订单实付"}
{"id": "Q004", "query": "平均每笔订单的实付金额", "category": "single_metric", "difficulty": "medium", "source": "manual", "required_slots": [{"name": "金额", "any_of": ["ecommerce_ops.orders.paid_amount", "orders_current.paid_amount"]}, {"name": "订单标识", "any_of": ["ecommerce_ops.orders.order_id", "orders_current.order_id"]}], "forbidden": ["ecommerce_ops.orders.payable_amount"], "gold_sql": "SELECT AVG(paid_amount) FROM orders", "notes": "客单价需要金额与订单数两个要素"}
{"id": "Q005", "query": "最近30天每天的订单数", "category": "time_window", "difficulty": "easy", "source": "manual", "required_slots": [{"name": "下单时间", "any_of": ["ecommerce_ops.orders.ordered_at", "orders_current.order_date", "orders_history.order_date"]}, {"name": "订单标识", "any_of": ["ecommerce_ops.orders.order_id", "orders_current.order_id"]}], "forbidden": [], "gold_sql": "SELECT DATE_TRUNC('day', ordered_at) d, COUNT(*) FROM orders GROUP BY 1", "notes": "按天分组必须拿到时间字段"}
{"id": "Q006", "query": "今年上半年各月销售额趋势", "category": "time_window", "difficulty": "medium", "source": "manual", "required_slots": [{"name": "时间", "any_of": ["ecommerce_ops.orders.ordered_at", "orders_current.order_date"]}, {"name": "金额", "any_of": ["ecommerce_ops.orders.paid_amount", "orders_current.paid_amount"]}], "forbidden": ["ecommerce_ops.orders.item_amount"], "gold_sql": "SELECT DATE_TRUNC('month', ordered_at) m, SUM(paid_amount) FROM orders GROUP BY 1 ORDER BY 1", "notes": "趋势=按月聚合，时间与金额缺一不可"}
{"id": "Q007", "query": "昨天有多少笔退款申请", "category": "time_window", "difficulty": "easy", "source": "manual", "required_slots": [{"name": "申请时间", "any_of": ["ecommerce_ops.refunds.applied_at"]}, {"name": "退款标识", "any_of": ["ecommerce_ops.refunds.refund_id"]}], "forbidden": [], "gold_sql": "SELECT COUNT(*) FROM refunds WHERE CAST(applied_at AS DATE) = CURRENT_DATE - 1", "notes": "申请时间 applied_at 不是完成时间"}
{"id": "Q008", "query": "本月新注册的用户有多少", "category": "time_window", "difficulty": "easy", "source": "manual", "required_slots": [{"name": "注册时间", "any_of": ["ecommerce_ops.users.registered_at"]}, {"name": "用户标识", "any_of": ["ecommerce_ops.users.user_id"]}], "forbidden": [], "gold_sql": "SELECT COUNT(*) FROM users WHERE registered_at >= DATE '2026-10-01'", "notes": "注册时间 registered_at"}
{"id": "Q009", "query": "各季度发货包裹总量", "category": "time_window", "difficulty": "medium", "source": "manual", "required_slots": [{"name": "发货时间", "any_of": ["ecommerce_ops.shipments.shipped_at"]}, {"name": "包裹数量", "any_of": ["ecommerce_ops.shipments.package_count"]}], "forbidden": [], "gold_sql": "SELECT QUARTER(shipped_at), SUM(package_count) FROM shipments GROUP BY 1", "notes": "包裹数是 package_count"}
{"id": "Q010", "query": "各品类销售额排名", "category": "multi_table_join", "difficulty": "hard", "source": "manual", "required_slots": [{"name": "金额", "any_of": ["ecommerce_ops.orders.paid_amount", "ecommerce_ops.order_items.paid_amount"]}, {"name": "类目名称", "any_of": ["ecommerce_ops.product_categories.category_name"]}, {"name": "商品关联", "any_of": ["ecommerce_ops.order_items.product_id", "ecommerce_ops.products.category_id"]}, {"name": "订单关联", "any_of": ["ecommerce_ops.order_items.order_id"]}], "forbidden": [], "gold_sql": "SELECT c.category_name, SUM(oi.paid_amount) FROM order_items oi JOIN orders o USING(order_id) JOIN products p ON p.product_id=oi.product_id JOIN product_categories c ON c.category_id=p.category_id GROUP BY 1 ORDER BY 2 DESC", "notes": "需 orders→order_items→products→product_categories 三跳"}
{"id": "Q011", "query": "各省份的退款率", "category": "multi_table_join", "difficulty": "hard", "source": "manual", "required_slots": [{"name": "退款金额", "any_of": ["ecommerce_ops.refunds.refund_amount"]}, {"name": "订单金额", "any_of": ["ecommerce_ops.orders.paid_amount"]}, {"name": "省份", "any_of": ["ecommerce_ops.orders.province"]}, {"name": "关联键", "any_of": ["ecommerce_ops.refunds.order_id"]}], "forbidden": [], "gold_sql": "SELECT o.province, SUM(r.refund_amount)/SUM(o.paid_amount) FROM orders o JOIN refunds r USING(order_id) GROUP BY 1", "notes": "比率=两表金额相除，必须同时拿到两个金额字段"}
{"id": "Q012", "query": "各店铺的客单价", "category": "multi_table_join", "difficulty": "hard", "source": "manual", "required_slots": [{"name": "店铺名称", "any_of": ["ecommerce_ops.stores.store_name"]}, {"name": "金额", "any_of": ["ecommerce_ops.orders.paid_amount"]}, {"name": "订单标识", "any_of": ["ecommerce_ops.orders.order_id"]}, {"name": "店铺关联", "any_of": ["ecommerce_ops.orders.store_id"]}], "forbidden": ["ecommerce_ops.stores.commission_rate"], "gold_sql": "SELECT s.store_name, AVG(o.paid_amount) FROM stores s JOIN orders o USING(store_id) GROUP BY 1", "notes": "commission_rate 是佣金率，不是客单价"}
{"id": "Q013", "query": "不同支付方式的支付金额分布", "category": "multi_table_join", "difficulty": "medium", "source": "manual", "required_slots": [{"name": "支付方式", "any_of": ["ecommerce_ops.payments.payment_method"]}, {"name": "支付金额", "any_of": ["ecommerce_ops.payments.payment_amount"]}], "forbidden": ["ecommerce_ops.orders.paid_amount"], "gold_sql": "SELECT payment_method, SUM(payment_amount) FROM payments GROUP BY 1", "notes": "支付金额用 payments.payment_amount，虽然 orders.paid_amount 语义接近"}
{"id": "Q014", "query": "各品牌的商品销量", "category": "multi_table_join", "difficulty": "hard", "source": "manual", "required_slots": [{"name": "品牌", "any_of": ["ecommerce_ops.products.brand_id"]}, {"name": "数量", "any_of": ["ecommerce_ops.order_items.quantity"]}, {"name": "商品关联", "any_of": ["ecommerce_ops.order_items.product_id"]}], "forbidden": ["ecommerce_ops.orders.item_amount"], "gold_sql": "SELECT p.brand_id, SUM(oi.quantity) FROM order_items oi JOIN products p USING(product_id) GROUP BY 1", "notes": "销量=数量求和，不是金额"}
{"id": "Q015", "query": "成交额最高的城市是哪个", "category": "alias_colloquial", "difficulty": "medium", "source": "manual", "required_slots": [{"name": "金额", "any_of": ["ecommerce_ops.orders.paid_amount"]}, {"name": "城市", "any_of": ["ecommerce_ops.orders.city"]}], "forbidden": ["ecommerce_ops.orders.item_amount", "ecommerce_ops.orders.payable_amount"], "gold_sql": "SELECT city FROM orders GROUP BY 1 ORDER BY SUM(paid_amount) DESC LIMIT 1", "notes": "口语『成交额』是 paid_amount 的别名"}
{"id": "Q016", "query": "客单价是多少", "category": "alias_colloquial", "difficulty": "medium", "source": "manual", "required_slots": [{"name": "金额", "any_of": ["ecommerce_ops.orders.paid_amount"]}, {"name": "订单标识", "any_of": ["ecommerce_ops.orders.order_id"]}], "forbidden": ["ecommerce_ops.stores.commission_rate"], "gold_sql": "SELECT AVG(paid_amount) FROM orders", "notes": "『客单价』没有同名字段，只能靠语义映射"}
{"id": "Q017", "query": "哪几个大区卖得最好", "category": "alias_colloquial", "difficulty": "medium", "source": "manual", "required_slots": [{"name": "大区", "any_of": ["ecommerce_ops.orders.region", "orders_current.region"]}, {"name": "金额", "any_of": ["ecommerce_ops.orders.paid_amount", "orders_current.paid_amount"]}], "forbidden": [], "gold_sql": "SELECT region, SUM(paid_amount) FROM orders GROUP BY 1 ORDER BY 2 DESC", "notes": "『卖得好』需映射为金额排名"}
{"id": "Q018", "query": "退货金额有多少", "category": "alias_colloquial", "difficulty": "easy", "source": "manual", "required_slots": [{"name": "退款金额", "any_of": ["ecommerce_ops.refunds.refund_amount"]}], "forbidden": ["ecommerce_ops.orders.paid_amount"], "gold_sql": "SELECT SUM(refund_amount) FROM refunds", "notes": "『退货金额』是 refund_amount 的别名"}
{"id": "Q019", "query": "各店铺的佣金率是多少", "category": "alias_colloquial", "difficulty": "medium", "source": "manual", "required_slots": [{"name": "佣金率", "any_of": ["ecommerce_ops.stores.commission_rate"]}, {"name": "店铺", "any_of": ["ecommerce_ops.stores.store_name"]}], "forbidden": ["ecommerce_ops.orders.paid_amount"], "gold_sql": "SELECT store_name, commission_rate FROM stores", "notes": "率值字段容易误召金额字段"}
{"id": "Q020", "query": "销售额是多少", "category": "confusable_field", "difficulty": "medium", "source": "manual", "required_slots": [{"name": "销售额", "any_of": ["ecommerce_ops.orders.paid_amount", "orders_current.paid_amount"]}], "forbidden": ["ecommerce_ops.orders.payable_amount", "ecommerce_ops.orders.item_amount", "ecommerce_ops.orders.discount_amount", "orders_current.order_amount"], "gold_sql": "SELECT SUM(paid_amount) FROM orders", "notes": "本项目最典型痛点：同表内 payable/item/discount 都是金额，只有 paid 是销售额"}
{"id": "Q021", "query": "应付金额和实付金额差多少", "category": "confusable_field", "difficulty": "hard", "source": "manual", "required_slots": [{"name": "应付", "any_of": ["ecommerce_ops.orders.payable_amount"]}, {"name": "实付", "any_of": ["ecommerce_ops.orders.paid_amount"]}], "forbidden": ["ecommerce_ops.orders.item_amount"], "gold_sql": "SELECT SUM(payable_amount - paid_amount) FROM orders", "notes": "两个都要，只召对一个等于零分"}
{"id": "Q022", "query": "商品原价总额是多少", "category": "confusable_field", "difficulty": "hard", "source": "manual", "required_slots": [{"name": "原始金额", "any_of": ["ecommerce_ops.orders.item_amount"]}], "forbidden": ["ecommerce_ops.orders.paid_amount", "ecommerce_ops.orders.payable_amount"], "gold_sql": "SELECT SUM(item_amount) FROM orders", "notes": "『原价』对应 item_amount，用 paid_amount 就错了"}
{"id": "Q023", "query": "毛利有多少", "category": "confusable_field", "difficulty": "hard", "source": "manual", "required_slots": [{"name": "收入", "any_of": ["ecommerce_ops.order_items.paid_amount"]}, {"name": "成本", "any_of": ["ecommerce_ops.order_items.cost_amount"]}], "forbidden": ["ecommerce_ops.orders.payable_amount"], "gold_sql": "SELECT SUM(paid_amount - cost_amount) FROM order_items", "notes": "毛利=收入-成本，必须同时召回两个字段"}
{"id": "Q024", "query": "一共优惠了多少钱", "category": "confusable_field", "difficulty": "medium", "source": "manual", "required_slots": [{"name": "优惠金额", "any_of": ["ecommerce_ops.orders.discount_amount", "ecommerce_ops.order_items.discount_amount"]}], "forbidden": ["ecommerce_ops.orders.paid_amount"], "gold_sql": "SELECT SUM(discount_amount) FROM orders", "notes": "discount_amount 与 paid_amount 同处金额字段群"}
{"id": "Q025", "query": "本月订单有多少", "category": "table_disambiguation", "difficulty": "hard", "source": "manual", "required_slots": [{"name": "订单标识", "any_of": ["orders_current.order_id"]}, {"name": "时间", "any_of": ["orders_current.order_date"]}], "forbidden": ["orders_history.order_id"], "gold_sql": "SELECT COUNT(*) FROM orders_current", "notes": "『本月』对应 orders_current，不是历史表也不是电商库 orders"}
{"id": "Q026", "query": "6月份的订单明细", "category": "table_disambiguation", "difficulty": "hard", "source": "manual", "required_slots": [{"name": "订单标识", "any_of": ["orders_history.order_id"]}, {"name": "时间", "any_of": ["orders_history.order_date"]}], "forbidden": ["orders_current.order_id"], "gold_sql": "SELECT * FROM orders_history WHERE order_date >= DATE '2026-06-01'", "notes": "6 月属于历史归档，orders_history 描述为 6-7 月"}
{"id": "Q027", "query": "历史订单的付款总额", "category": "table_disambiguation", "difficulty": "medium", "source": "manual", "required_slots": [{"name": "金额", "any_of": ["orders_history.paid_amount"]}], "forbidden": ["orders_current.paid_amount", "ecommerce_ops.orders.payable_amount"], "gold_sql": "SELECT SUM(paid_amount) FROM orders_history", "notes": "『历史订单』是 orders_history 的 business_terms"}
{"id": "Q028", "query": "本月各地区销售目标完成率", "category": "table_disambiguation", "difficulty": "hard", "source": "manual", "required_slots": [{"name": "目标额", "any_of": ["sales_targets.target_amount"]}, {"name": "目标月份", "any_of": ["sales_targets.target_month"]}, {"name": "地区", "any_of": ["sales_targets.region"]}, {"name": "实际金额", "any_of": ["orders_current.paid_amount"]}], "forbidden": ["ecommerce_ops.orders.item_amount"], "gold_sql": "SELECT t.region, SUM(o.paid_amount)/t.target_amount FROM sales_targets t JOIN orders_current o ON o.region=t.region GROUP BY 1", "notes": "目标表与实际表都要，缺一不可"}
